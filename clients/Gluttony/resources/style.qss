* {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
    color: #1f2937;
}

QMainWindow {
    background: #f4f6f8;
}

/* Bottom status bar */
QStatusBar {
    background: #ffffff;
    color: #374151;
    border: none;
    border-top: 1px solid #d7dde5;
    min-height: 34px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background: transparent;
    color: #374151;
    border: none;
    padding: 0 4px;
}

QStatusBar QFrame#StatusBarSeparator {
    background: #d7dde5;
    border: none;
    max-width: 1px;
}

QStatusBar QLabel#FooterNg {
    color: #dc2626;
    font-weight: 700;
}

QStatusBar QLabel#FooterOk {
    color: #16a34a;
    font-weight: 700;
}

/* Top toolbar */
QToolBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #d7dde5;
    border-bottom: 1px solid #d7dde5;
    spacing: 10px;
    padding: 8px 10px;
}

QToolButton {
    padding: 7px 12px;
}

QToolButton:hover {
}

QToolButton:pressed {
    background: #dbeafe;
}

/* Panels */
QGroupBox {
    background: #ffffff;
    border: 1px solid #d7dde5;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #374151;
    background: #ffffff;
}

/* Inputs */
QLineEdit, QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 22px;
}

QLineEdit:focus, QDoubleSpinBox:focus {
    border: 1px solid #2563eb;
}

/* Buttons */
QPushButton {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background: #1d4ed8;
}

QPushButton:pressed {
    background: #1e40af;
}

QPushButton:disabled {
    background: #cbd5e1;
    color: #64748b;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #e5e7eb;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background: #2563eb;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #93c5fd;
    border-radius: 3px;
}

/* Image preview panels */
QLabel#ImageView {
    background: #111827;
    color: #9ca3af;
    border: 1px solid #1f2937;
    border-radius: 8px;
    qproperty-alignment: AlignCenter;
    font-size: 15px;
}

/* Result status */
QLabel#ResultNg {
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 12px;
    font-size: 24px;
    font-weight: 800;
}

QLabel#ResultOk {
    color: #16a34a;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 12px;
    font-size: 24px;
    font-weight: 800;
}

/* Metric labels */
QLabel#MetricLabel {
    background: #d7dde5;
    color: #374151;
    border: none;
    border-bottom: 1px solid #d7dde5;
    border-radius: 0;
    padding: 0 8px;
    min-height: 28px;
    font-weight: 700;
}

QLabel#SectionLabel {
    background: transparent;
    color: #374151;
    border: none;
    padding: 0;
    min-height: 20px;
    font-weight: 700;
}

QWidget#PanelContent {
    background: transparent;
    border: none;
}

QFrame#PanelSeparator {
    color: #cbd5e1;
    background: #cbd5e1;
    max-height: 1px;
    border: none;
}


/* Log */
QPlainTextEdit#LogPanel {
    background: #0f172a;
    color: #cbd5e1;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas";
    font-size: 12px;
}

/* Log panel */
QWidget#LogWidget {
    background: #ffffff;
    border: 1px solid #d7dde5;
    border-radius: 8px;
}

QWidget#LogTitleBar {
    background: transparent;
    border: none;
}

QLabel#LogTitle {
    color: #111827;
    border: none;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#LogClearButton,
QPushButton#LogSaveButton {
    background: #ffffff;
    color: #374151;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    min-height: 22px;
    padding: 3px 9px;
    font-weight: 600;
}

QPushButton#LogSaveButton {
    min-width: 26px;
    max-width: 26px;
    padding: 3px;
}

QPushButton#LogClearButton:hover,
QPushButton#LogSaveButton:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton#LogClearButton:pressed,
QPushButton#LogSaveButton:pressed {
    background: #e2e8f0;
}

QTextBrowser#LogPanel {
    background: #f8fafc;
    color: #334155;
    border: 1px solid #d7dde5;
    border-radius: 6px;
    padding: 8px;
    font-family: "Consolas", "Cascadia Mono";
    font-size: 12px;
}

/* Table */
QTableWidget, QTableView#DetectionResultTable {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #d7dde5;
    border-radius: 8px;
    gridline-color: #e5e7eb;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

QTableWidget QHeaderView::section, QTableView#DetectionResultTable QHeaderView::section {
    background: #f1f5f9;
    color: #334155;
    border: none;
    border-right: 1px solid #d7dde5;
    border-bottom: 1px solid #d7dde5;
    padding: 7px 8px;
    font-weight: 700;
}

QTableCornerButton::section, QTableView#DetectionResultTable QTableCornerButton::section {
    background: #f1f5f9;
    border: none;
}

/* Splitter */
QSplitter::handle {
    background: #e5e7eb;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QWidget#ModelWidget {
    background: #f8fafc;
    border: 1px solid #d7dde5;
}

QWidget#ParamWidget {
    background: #f8fafc;
    border: 1px solid #d7dde5;
}

QWidget#ModelWidget QPushButton,
QWidget#ParamWidget QPushButton {
    background: #ffffff;
    color: #374151;
    border: 1px solid #cbd5e1;
}

QWidget#ModelWidget QPushButton:hover,
QWidget#ParamWidget QPushButton:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
}

QWidget#ModelWidget QPushButton:pressed,
QWidget#ParamWidget QPushButton:pressed {
    background: #e2e8f0;
}

/* Quick result */
QWidget#QuickResWidget {
    background: #ffffff;
    border: 1px solid #d7dde5;
    border-radius: 8px;
}

QLabel#QuickResultTitle {
    color: #111827;
    border: none;
    font-size: 24px;
    font-weight: 700;
}

QLabel#QuickResultValue {
    border: none;
    font-size: 28px;
    font-weight: 800;
}

QLabel#QuickMetricTitle {
    color: #374151;
    border: none;
    font-size: 15px;
    font-weight: 600;
}

QLabel#QuickScoreValue {
    border: none;
    font-size: 20px;
    font-weight: 800;
}

QLabel#QuickInference,
QLabel#QuickDefectArea {
    background: transparent;
    color: #374151;
    border: none;
    border-radius: 0;
    padding: 9px 4px;
    min-height: 24px;
    font-size: 14px;
    font-weight: 600;
}

QLabel#QuickInference {
    border-bottom: 1px solid #e5e7eb;
}

QFrame#QuickSectionSeparator {
    background: #e5e7eb;
    border: none;
    max-height: 1px;
}

/* Image comparison view */
QWidget#ViewWidget {
    background: transparent;
}

QWidget#ImagePanel {
    background: #ffffff;
    border: 1px solid #d7dde5;
    border-radius: 8px;
}

QLabel#ImagePanelTitle {
    background: #ffffff;
    color: #334155;
    border: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 0 8px;
    font-weight: 700;
    font-size: 15px;
}

QGraphicsView#ImageGraphicsView {
    background: transparent;
    border: none;
}

QGraphicsView#ImageGraphicsView:focus {
    border: none;
}

QLabel#ImagePanelFooter {
    background: #ffffff;
    color: #64748b;
    border: none;
    border-top: 1px solid #e5e7eb;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding: 0 8px;
    font-size: 12px;
}

QWidget#ResultImageFooter {
    background: #ffffff;
    border: none;
    border-top: 1px solid #e5e7eb;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

QLabel#HeatmapLegendLabel {
    background: transparent;
    color: #475569;
    border: none;
    font-size: 12px;
}

QFrame#HeatmapGradient {
    border: 1px solid #cbd5e1;
    border-radius: 2px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0.00 #1e3a8a,
        stop: 0.22 #2563eb,
        stop: 0.43 #06b6d4,
        stop: 0.63 #facc15,
        stop: 0.82 #f97316,
        stop: 1.00 #dc2626
    );
}

QComboBox {
    background: #f8fafc;
    color: #1f2937;
    border: 1px solid #8a94a6;
    border-radius: 2px;
    padding: 5px 30px 5px 8px;
    min-height: 24px;
    font-weight: 500;
}

QComboBox:hover {
    border: 1px solid #4b5563;
    background: #ffffff;
}

QComboBox:focus {
    border: 1px solid #2563eb;
    background: #ffffff;
}

QComboBox:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    border: 1px solid #cbd5e1;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #9ca3af;
    background: #e5e7eb;
}

QComboBox::drop-down:hover {
    background: #d1d5db;
}

QComboBox::down-arrow {
    image: url(:/down-arrow.svg);
    subcontrol-origin: padding;
    subcontrol-position: center;
    width: 12px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #6b7280;
    outline: 0;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background: #dbeafe;
    color: #1e3a8a;
}

QComboBox QAbstractItemView::item:selected {
    background: #2563eb;
    color: #ffffff;
}
